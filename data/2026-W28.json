  "themes": [
    {
      "theme": "H1 2026 VC record",
      "summary": "US companies raised $412.7B Jan-Jun 2026 (PitchBook/NVCA) -- more than any full prior year; +29% vs all of 2025, +15% vs the 2021 record. 81%+ of H1 dollars went to $100m+ mega-rounds; 7 rounds of $1b+ in Q2 alone."
    },
    {
      "theme": "Defense-tech undersea arms race",
      "summary": "Lockheed Martin buys naval-tech firm Ultra Maritime for $3.45B (Advent Intl); Thales buys submarine-drone maker Exail for ~$4.2B. Straight of Hormuz tension is driving demand for autonomous undersea weapons after years of aerial-drone focus."
    },
    {
      "theme": "European bank/asset-manager consolidation",
      "summary": "UniCredit pushed its Commerzbank stake to 47.6% (49.65% of voting shares), setting up Europe's biggest bank merger fight in two decades against German government opposition. Separately B Capital + CalPERS agreed to buy 90-year-old Russell Investments (~$2.8B) from TA/Reverence -- unusual for a VC firm to buy a legacy asset manager."
    },
    {
      "theme": "EasyJet bidding war",
      "summary": "Castlelake's £5.2B agreed buyout of EasyJet was topped by a £5.7B competing offer from Apollo on 7/10, setting up a bidding war for Europe's #2 budget carrier amid rising fuel costs and Middle East conflict pressure on margins."
    },
    {
      "theme": "Fusion/nuclear/geothermal energy financing",
      "summary": "Proxima Fusion (Germany) raised Europe's largest-ever fusion VC round (€411m @ €2.4b post); Standard Nuclear (SMR fuel) set IPO terms (~$3.7b val); Quaise Energy, Hephae Energy, Bohr Energie, Axle Energy, XGS Energy all raised/advanced -- broad geothermal/nuclear/grid financing wave tied to AI power demand."
    },
    {
      "theme": "AI-agent-negotiates-with-AI-agent theme",
      "summary": "Lyzr, an enterprise AI-agent-building startup, is using its own product to raise a $100m Series B -- Dan Primack flags this as an early signal that agentic AI could start negotiating deals directly, undercutting relationship-driven dealmaking."
    },
    {
      "theme": "Founder-fraud due-diligence failure",
      "summary": "AppliedAI (Opus) founder Arya Bolurfrushan secretly pleaded guilty in June 2025 to insider-trading conspiracy tied to M&A tips (incl. Sixth Street's $5.1b Enstar deal), yet kept raising and closing partnerships (McKinsey, EY) from top investors (Group 42, Bessemer, Palantir, Mubadala) who apparently didn't know."
    }
  ],
